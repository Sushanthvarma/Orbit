rules_version = '2';

// Orbit receipt images. Ledger-only app — these are user-uploaded receipt
// photos, stored under receipts/{groupId}/{fileName}. Any signed-in user may
// read/write (group-membership is enforced in Firestore, not here); writes are
// capped to image/* under 5 MB so the bucket can't be abused as general storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{groupId}/{fileName} {
      allow read: if request.auth != null;
      // Hard cap: receipt images must be an image under 2.5 MB.
      allow write: if request.auth != null
                   && request.resource.size < 2.5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
  }
}
