// ============================================================
// Orbit — Firestore Security Rules
//
// Two coexisting models during the multi-user migration:
//   1. LEGACY (Phase 0): per-user private data under /orbit/{uid}/**.
//      Untouched — existing single-user data keeps working.
//   2. SHARED (Phase A): real multi-user groups under /groups/{id},
//      plus top-level /users/{uid} profiles and /invites/{code}.
//      Access is MEMBERSHIP-BASED: you can touch a group only if your
//      uid is in that group's memberUids array.
//
// Deploy: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    // Read a group's member list without failing if the doc is missing.
    function groupMembers(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }
    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && uid() in groupMembers(groupId);
    }

    // ============================================================
    // LEGACY per-user model (Phase 0) — unchanged.
    // ============================================================
    match /orbit/{ownerUid}/{document=**} {
      allow read, write: if signedIn() && uid() == ownerUid;
    }
    match /orbit/{ownerUid} {
      allow read, write: if signedIn() && uid() == ownerUid;
    }

    // ============================================================
    // SHARED multi-user model (Phase A).
    // ============================================================

    // Public-ish profile per real user. A signed-in user may GET an
    // individual profile *if they already know the uid* (needed to render a
    // co-member's name/avatar/UPI). LIST is denied so nobody can enumerate the
    // whole user base and harvest every email / phone / UPI id — uids are
    // unguessable, so you only learn one by sharing a group with that person.
    // (The owner-side "add existing user by email/phone" lookup runs in a
    // trusted Cloud Function with the admin SDK, which bypasses these rules,
    // so denying client list/query here breaks nothing.)
    match /users/{profileUid} {
      allow get: if signedIn();
      // Only the founder may LIST every signed-in user (the admin roster). A
      // normal user still can't enumerate everyone — only get() a known uid.
      allow list: if signedIn() && request.auth.token.email == 'sushanthvarma@gmail.com';
      allow write: if signedIn() && uid() == profileUid;
    }

    // A shared group. Membership is the access boundary.
    match /groups/{groupId} {
      // Read only if you are a member. IMPORTANT: use resource.data.memberUids
      // (the doc being read) — NOT a get() — so the "list my groups" query
      // (where memberUids array-contains uid) is permitted. A get()-based rule
      // makes collection queries fail with permission-denied, which is why an
      // invited member's group never showed up.
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      // The founder may LIST every group for the admin dashboard. Non-members
      // still can't get() an individual group they don't belong to.
      allow list: if signedIn() && request.auth.token.email == 'sushanthvarma@gmail.com';

      // Create only if you stamp yourself as creator AND include
      // yourself in the initial member list (no creating groups you
      // aren't part of, no forging another creator).
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && uid() in request.resource.data.memberUids;

      // Only the OWNER may change the group's own fields (rename, currency,
      // category, archived). Members cannot re-configure a shared group. The
      // creator and the member roster (memberUids) stay immutable here
      // regardless — the roster is mutated ONLY by the trusted Cloud Functions
      // (acceptInvite / leaveGroup / removeMember / claimPending), which run
      // with admin privileges and bypass these rules.
      allow update: if signedIn()
        && resource.data.createdBy == uid()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberUids == resource.data.memberUids;

      // Only the creator may delete the whole group.
      allow delete: if signedIn() && resource.data.createdBy == uid();

      // Expenses & settlements: any group member can read/write.
      match /expenses/{expenseId} {
        allow read, write: if isGroupMember(groupId);
      }
      match /settlements/{settlementId} {
        allow read, write: if isGroupMember(groupId);
      }
      match /activity/{activityId} {
        allow read, write: if isGroupMember(groupId);
      }
      // Receipt images (one doc per expense). Members can read/write so every
      // member can review the group's receipts in the Receipts tab.
      match /receipts/{expenseId} {
        allow read, write: if isGroupMember(groupId);
      }
    }

    // Invites. The invite doc carries a groupId + expiry.
    //  - Read: anyone signed in who has the invite code (codes are
    //    unguessable random IDs; reading one lets the invitee see which
    //    group they're joining before accepting).
    //  - Create: only by a member of the group being invited to.
    //  - Update/delete: only the inviter (e.g. to revoke).
    // NOTE: actually ADDING a member to a group on accept is done by a
    // trusted Cloud Function (Phase B) so membership can't be forged
    // client-side. These rules only govern the invite record itself.
    match /invites/{inviteCode} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.invitedBy == uid()
        && uid() in groupMembers(request.resource.data.groupId);
      allow update, delete: if signedIn() && resource.data.invitedBy == uid();
    }

    // Pending claim tickets (Phase 2 auto-claim). A ticket is addressed to a
    // person's email/phone (the {handle} doc id). When that person signs in,
    // a trusted Cloud Function (claimPending) links their uid and rewrites the
    // group's splits ghost->uid. A user may READ only tickets addressed to
    // their OWN verified handle; a group member may CREATE tickets for that
    // group; only the function (admin) updates/deletes them.
    match /pendingClaims/{handle}/tickets/{ticketId} {
      allow read: if signedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == handle) ||
        (request.auth.token.phone_number == handle)
      );
      allow create: if signedIn()
        && request.resource.data.invitedBy == uid()
        && isGroupMember(request.resource.data.groupId);
      allow update, delete: if false;
    }

    // Identity index (verified handle -> uid). Written and read ONLY by the
    // trusted Cloud Functions (the admin SDK bypasses these rules). No client
    // access: deny so a signed-in user can't enumerate handle->uid mappings and
    // harvest the account base. (The default-deny below would cover this too;
    // it's spelled out for intent.)
    match /identities/{handle} {
      allow read, write: if false;
    }

    // Founder-only global activity feed (every join across the whole app).
    // Written only by trusted Cloud Functions; readable only by the owner.
    match /adminFeed/{docId} {
      allow read: if signedIn() && request.auth.token.email == 'sushanthvarma@gmail.com';
      allow write: if false;
    }

    // ---- default deny ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
