// ============================================================
// Orbit — Firestore Security Rules
// Per-user isolation: a signed-in user can only read/write
// documents under /orbit/{their own uid}/**.
// Deploy via: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules.
// ============================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Profile document and every sub-collection under it.
    match /orbit/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
